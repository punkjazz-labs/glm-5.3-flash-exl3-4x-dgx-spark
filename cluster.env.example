# GLM-5.3-Flash EXL3 TP4 on four NVIDIA DGX Sparks. Copy to cluster.env, edit, keep out of git (.gitignore covers *.env).
# All scripts run on rank 0 (the head) as RANK_USER and reach the other ranks over the fabric with SSH_OPTS.
TAG=prod                                   # container name suffix: glm53-tp4-<TAG>-r<rank>
RANK_USER=spark                            # OS user on every rank
HEAD_IP=10.0.0.1                           # rank 0 fabric address (NCCL master, API bind)
RANK_IPS=(10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4)   # fabric (RoCE) address of rank 0..3, all on NETDEV
NETDEV=enp1s0f1np1                         # ConnectX-7 port carrying the fabric addresses (same on every rank)
HCA=rocep1s0f1                             # its RDMA device
RANK_DK=("docker" "docker" "docker" "docker")     # docker command per rank ("sudo -n docker" where needed)
# Engine image per rank. Build it from MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks (BUILD=1 ./start.sh at the commit you
# want, or pull ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3) and pin the resulting image ID on every rank.
RANK_IMG=(IMAGE_ID IMAGE_ID IMAGE_ID IMAGE_ID)
# overlay/ + files/ of the SAME recipe commit as the image, identical on every rank (node-launch.sh mounts them).
ROOT=/home/spark/AI/glm53-tp4-root
# HF cache holding the two snapshots (per rank if they differ: RANK_HF=(...)).
HF=/home/spark/.cache/huggingface
VC=/home/spark/.cache/vllm-glm53-tp4        # vLLM/Triton/TileLang compile caches (per rank)
PORT=8890
RDV=29531                                  # torch rendezvous port on HEAD_IP
SPEC_METHOD=none                           # dflash | none. none since 2026-09-03 as a mitigation: long chunked prefills can stall this build, the draft raises the odds (see README)
DRAFT_TP=4                                 # shard the DFlash2 drafter over all ranks
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/spark/.ssh/known_hosts.tp4 -o ConnectTimeout=15 -o ServerAliveInterval=15 -i /home/spark/.ssh/id_ed25519_cluster"
# Optional: an incumbent 2-node (TP2) deployment that tp4-cutover.sh stops and tp4-rollback.sh / the watchdog restart.
# TP2_HEAD=glm53-exl3-head-...
# TP2_WORKER=glm53-exl3-worker-...
# TP2_WORKER_IP=10.0.0.2

# ---- serving knobs (the values below are the tuned production settings, see README "Tuning") ----
GPU_MEM_UTIL=0.75          # 0.85 leaves <1 GiB host memory on GB10 and preceded two engine deaths; 0.75 keeps ~9 GiB
MAX_NUM_SEQS=8             # 4 caps aggregate at ~85 tok/s; 8 gives ~135 tok/s and sub-second first tokens at 8 streams
DFLASH_TOKENS=3            # draft length: 3 accepts 53% (decode 31-33 tok/s) vs 30% at 7 (26-28 tok/s)
MAX_NUM_BATCHED_TOKENS=2048  # 4096/8192 do not prefill faster on TP4 and wreck first-token latency under load
MIXED_PREFILL_CHUNK=off    # off: new prefills share steps with running decodes (skip = never, protects decode speed)
EXL3_FAT_KERNEL=1          # E2 fat-expert prefill kernel (upstream PR77): needs an image built from c190db1 or later
# MAX_MODEL_LEN=1000000 KV_CACHE_DTYPE=fp8 EXTRA_ARGS=""
