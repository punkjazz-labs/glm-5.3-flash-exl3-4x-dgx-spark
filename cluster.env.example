# Selected H16 attention-slice recipe. Copy to cluster.env and replace every
# placeholder before launch. This file is sourced by bash; keep shell quoting.
TAG=attention64h16
RANK_USER=YOUR_USER
HEAD_IP=10.0.0.1
RANK_IPS=(10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4)
# Primary RoCE interface/HCA for bootstrap. The selected configuration also
# validates the secondary HCA through NCCL_IB_HCA and NCCL_IB_ADDR_RANGE below.
NETDEV=YOUR_PRIMARY_ROCE_NETDEV
HCA=YOUR_PRIMARY_ROCE_HCA
RANK_DK=("docker" "docker" "docker" "docker")
RANK_IMG=(IMAGE_DIGEST IMAGE_DIGEST IMAGE_DIGEST IMAGE_DIGEST)

# A checked-out upstream runtime root at the pinned commit. It must contain
# overlay/ patches and files/chat_template.jinja required by node-launch.sh.
ROOT="${HOME}/glm53-upstream-root"
HF="${HOME}/.cache/huggingface"
VC="${HOME}/.cache/vllm-glm53-tp4"
PORT=8890
RDV=29531
SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15"

# Pinned selected configuration. Do not enable it against an image whose
# sparse MLA backend does not match recipe/patch_sparse_mla_slice.py.
SPEC_METHOD=dflash
DRAFT_TP=4
MAX_MODEL_LEN=1000000
GPU_MEM_UTIL=0.75
MAX_NUM_SEQS=8
DFLASH_TOKENS=3
MAX_NUM_BATCHED_TOKENS=2048
KV_CACHE_DTYPE=fp8
MIXED_PREFILL_CHUNK=off
EXL3_FAT_KERNEL=1
SWAPPINESS=60
EXTRA_ARGS=--enforce-eager
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_SM120_SPARSE_MLA_SLICE_TOKENS=64
# Both HCA names must have a RoCEv2 IPv4 GID inside this range. Configure PFC
# and ECN consistently for the selected data/control priorities on all hosts
# and switch ports before preflight; this recipe does not configure network QoS.
NCCL_IB_HCA="=YOUR_PRIMARY_ROCE_HCA,YOUR_SECONDARY_ROCE_HCA"
NCCL_IB_ADDR_RANGE=10.0.0.0/15
NCCL_IB_TC=106
NCCL_IB_FIFO_TC=192
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
RDMA_GID_MODE=auto
MAINT="${HOME}/tp4-attention64h16-maintenance"
